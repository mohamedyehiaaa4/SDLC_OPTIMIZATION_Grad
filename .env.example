# RepoMind — environment variables for the whole project (frontend + backend)
# Copy this file to .env in the project root and fill in the values.
# Never commit .env.

# =====================================================
# App
# =====================================================

# Where the FastAPI backend runs. The frontend proxies /api/* to it.
BACKEND_URL=http://localhost:8000

# Session cookies are only sent over HTTPS when true. Keep false for local
# development (http://localhost); set true in production.
COOKIE_SECURE=false

# =====================================================
# Supabase — used by the backend only (the frontend never talks to Supabase)
# Dashboard → Connect (or Project Settings → API keys)
# =====================================================

# Project URL, e.g. https://abcdefghijklmnop.supabase.co
SUPABASE_URL=

# Publishable / anon key
SUPABASE_ANON_KEY=

# Secret / service_role key — bypasses RLS
SUPABASE_SERVICE_ROLE_KEY=

# Direct PostgreSQL connection (Dashboard → Connect → connection string, with your DB password)
DATABASE_URL=

# =====================================================
# AI
# =====================================================

# OpenAI API key (platform.openai.com → API keys)
OPENAI_API_KEY=
