# RepoMind — environment variables for the whole project (frontend + backend)
# Copy this file to .env in the project root and fill in the values.
# Never commit .env.

# =====================================================
# Supabase — shared by frontend and backend
# Dashboard → Connect (or Project Settings → API keys)
# =====================================================

# Project URL, e.g. https://abcdefghijklmnop.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# Publishable / anon key — safe for the browser (RLS protects the data)
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# =====================================================
# Backend only — SECRET. Never prefix these with NEXT_PUBLIC_
# =====================================================

# Secret / service_role key — bypasses RLS
SUPABASE_SERVICE_ROLE_KEY=

# Direct PostgreSQL connection (Dashboard → Connect → connection string, with your DB password)
DATABASE_URL=

# OpenAI API key (platform.openai.com → API keys)
OPENAI_API_KEY=
